function simpanRefleksi(){const nama=document.getElementById('refNama').value.trim()||'Anonim'; const tgl=document.getElementById('refTanggal').value||new Date().toISOString().slice(0,10); const vals=[1,2,3,4,5,6,7].map(i=>parseInt(document.getElementById('r'+i).value.charAt(0))); const rata=(vals.reduce((a,b)=>a+b,0)/vals.length).toFixed(2); const cat=document.getElementById('rCatatan').value; const all=JSON.parse(localStorage.getItem('vertikal_refleksi')||'[]'); all.unshift({nama,tgl,vals,rata,cat}); localStorage.setItem('vertikal_refleksi',JSON.stringify(all)); tampilRefleksi(); alert('Refleksi tersimpan! Rata-rata hari ini: '+rata);}
function tampilRefleksi(){const all=JSON.parse(localStorage.getItem('vertikal_refleksi')||'[]'); document.getElementById('listRefleksi').innerHTML=all.length?all.map(f=>`<div class="fb-item"><b>${f.nama}</b> • ${f.tgl} • Rata-rata: <b>${f.rata} / 4</b><br><small>Bangun Pagi ${f.vals[0]} • Beribadah ${f.vals[1]} • Berolahraga ${f.vals[2]} • Makan Sehat dan Bergizi ${f.vals[3]} • Gemar Belajar ${f.vals[4]} • Bermasyarakat ${f.vals[5]} • Tidur Cepat ${f.vals[6]}</small><p>${f.cat||'-'}</p></div>`).join(''):'<p>Belum ada refleksi.</p>';}
