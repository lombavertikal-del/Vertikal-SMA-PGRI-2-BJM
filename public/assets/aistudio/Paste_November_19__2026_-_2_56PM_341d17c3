function tampilSemuaFb(){const all=getFb(); document.getElementById('allFeedback').innerHTML=all.length?all.map((f,i)=>`<div class="fb-item"><b>${f.kode}</b> • ${f.kategori} • ${f.oleh} • <small>${f.tgl}</small><p>${f.isi}</p><button onclick="hapusFb(${i})" style="padding:6px 10px;background:#EF4444">Hapus</button></div>`).join(''):'<p>Belum ada feedback.</p>';}
function hapusFb(i){const all=getFb(); all.splice(i,1); setFb(all); tampilSemuaFb(); tampilFeedbackKode();}
